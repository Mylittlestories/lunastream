# Authentication (REQUIRED - Change this to a random string!)
JWT_SECRET=your-super-secret-key-change-this-to-something-random

# Database
DATABASE_URL="file:./prisma/dev.db"

# Optional: OpenSubtitles API (for better subtitles)
# Get your API key at: https://www.opensubtitles.com/en/api
OPENSUBTITLES_API_KEY=

# Optional: TMDB API (for enhanced metadata)
# Get your API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional: Application URL (for sharing features)
NEXT_PUBLIC_APP_URL=http://localhost:3000
