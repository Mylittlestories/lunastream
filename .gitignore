*.tsbuildinfo

# Misc
.cache/
temp/
tmp/
*.tgz

# Capacitor (mobile builds)
android/
ios/

# Backup folders
*-backup*/

# Local scripts
local-*.sh
local-*.js
android-mobile/app/src/main/assets/
android-tv/app/src/main/assets/
out/
