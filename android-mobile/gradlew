#!/bin/sh

# Download and use Gradle (version kept in sync with gradle/wrapper/gradle-wrapper.properties)
GRADLE_VERSION="8.2"
GRADLE_DIR="${GRADLE_HOME:-/tmp/gradle-${GRADLE_VERSION}}"

if [ ! -x "${GRADLE_DIR}/bin/gradle" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "/tmp/gradle-${GRADLE_VERSION}.zip"
    unzip -q -o "/tmp/gradle-${GRADLE_VERSION}.zip" -d "$(dirname "${GRADLE_DIR}")"
fi

exec "${GRADLE_DIR}/bin/gradle" "$@"
