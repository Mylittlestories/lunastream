#!/bin/sh

# Download and use Gradle 8.2 (required by AGP 8.2).
# NOTE: do NOT honour GRADLE_HOME here - CI runners (and some desktops) set it
# to a newer Gradle that is incompatible with the Android Gradle Plugin.
# Override the install location with LUNASTREAM_GRADLE_DIR if needed.
GRADLE_VERSION="8.2"
GRADLE_DIR="${LUNASTREAM_GRADLE_DIR:-/tmp/gradle-${GRADLE_VERSION}}"

if [ ! -x "${GRADLE_DIR}/bin/gradle" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "/tmp/gradle-${GRADLE_VERSION}.zip"
    unzip -q -o "/tmp/gradle-${GRADLE_VERSION}.zip" -d "$(dirname "${GRADLE_DIR}")"
fi

exec "${GRADLE_DIR}/bin/gradle" "$@"
