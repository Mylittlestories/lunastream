{
  "name": "lunastream",
  "version": "1.1.0",
  "description": "A powerful Stremio-like streaming application with multi-source support, custom video player, and cross-platform desktop app.",
  "private": true,
  "main": "electron/main.js",
  "author": {
    "name": "LunaStream Team",
    "email": "lunastream@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/lunastream/lunastream#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lunastream/lunastream.git"
  },
  "bugs": {
    "url": "https://github.com/lunastream/lunastream/issues"
  },
  "keywords": [
    "streaming",
    "movies",
    "tv-shows",
    "stremio",
    "video-player",
    "electron",
    "nextjs",
    "pwa"
  ],
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "electron-start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "prisma generate && node scripts/patch-webtorrent.js"
  },
  "build": {
    "appId": "com.lunastream.app",
    "productName": "LunaStream",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      },
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "artifactName": "LunaStream-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LunaStream"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "category": "public.app-category.entertainment",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "LunaStream-${version}-${arch}.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "category": "Video;AudioVideo;",
      "maintainer": "LunaStream Team <lunastream@users.noreply.github.com>",
      "artifactName": "LunaStream-${version}-${arch}.${ext}",
      "desktop": {
        "Name": "LunaStream",
        "Comment": "Stream movies and TV shows",
        "Categories": "Video;AudioVideo;"
      }
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.0.0",
    "hls.js": "^1.6.10",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.438.0",
    "next": "^14.2.23",
    "next-auth": "^4.24.15",
    "next-pwa": "^5.6.0",
    "prisma": "^5.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webtorrent": "2.1.35"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "8.5.1",
    "@types/node": "24.0.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}